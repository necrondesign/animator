{
  "name": "haiku-mono",
  "private": true,
  "workspaces": [
    "packages/@haiku/*",
    "packages/haiku-*"
  ],
  "version": "5.1.2",
  "productName": "motion-side",
  "description": "motion-side — interactive animation editor (based on Haiku Animator)",
  "main": "index.js",
  "author": "Haiku Systems Inc.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "add-experiment": "node ./scripts/add-experiment.js",
    "demos": "node ./scripts/demos.js",
    "doctor": "node ./scripts/doctor.js",
    "go": "yarn start default",
    "lint": "eslint .",
    "semver": "node ./scripts/semver.js",
    "setup": "node ./scripts/setup.js",
    "start": "node ./scripts/start.js",
    "compile-all": "node ./scripts/compile-all.js",
    "lint-all": "eslint .",
    "test-all": "node ./scripts/test-all.js",
    "typecheck-all": "node ./scripts/typecheck-all.js",
    "smoke": "node ./scripts/smoke.js",
    "dist": "electron-builder --publish=never",
    "dist:dir": "electron-builder --dir --publish=never",
    "watch-all": "node ./scripts/watch-all.js",
    "test-report": "node ./scripts/test-report.js",
    "lint:fix": "eslint . --fix"
  },
  "resolutions": {
    "@haiku/core": "^5.0.0",
    "**/@types/react": "15.6.11",
    "@types/node": "24.19.0"
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "@haiku/cli": "5.1.2",
    "@haiku/core": "5.1.2",
    "@haiku/sdk-client": "5.1.2",
    "haiku-common": "5.1.2",
    "haiku-creator": "5.1.2",
    "haiku-formats": "5.1.2",
    "haiku-fs-extra": "5.1.2",
    "haiku-glass": "5.1.2",
    "haiku-plumbing": "5.1.2",
    "haiku-sdk-creator": "5.1.2",
    "haiku-serialization": "5.1.2",
    "haiku-timeline": "5.1.2",
    "haiku-ui-common": "5.1.2"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "async": "^2.5.0",
    "cli-color": "^1.2.0",
    "cross-env": "^5.1.6",
    "cross-spawn": "^6.0.5",
    "dependency-graph": "^0.5.0",
    "derequire": "^2.0.6",
    "dotenv": "^5.0.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "fs-extra": "^4.0.2",
    "git-branch": "0.3.0",
    "glob": "^7.1.2",
    "glob-all": "3.1.0",
    "globals": "17.12.0",
    "inquirer": "^3.0.6",
    "lodash": "^4.17.4",
    "moment": "2.18.1",
    "playwright-core": "1.63.0",
    "semver": "^5.4.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "tsc-watch": "^1.0.27",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "uglify-js": "^3.1.4",
    "yargs": "^6.6.0"
  },
  "standard": {
    "ignore": [
      "/packages/*"
    ]
  },
  "build": {
    "appId": "io.github.necrondesign.motion-side",
    "copyright": "Copyright (c) 2016-2021 Haiku Systems Inc.; 2026 necrondesign. AGPL-3.0-or-later.",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "productName": "motion-side",
    "forceCodeSigning": false,
    "afterSign": "scripts/notarize.js",
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "maintainer": "necrondesign <26086849+necrondesign@users.noreply.github.com>",
      "category": "Graphics;Development;VectorGraphics",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "icon": "build/dmgIcon.icns"
    },
    "protocols": {
      "name": "motion-side",
      "schemes": [
        "motion-side"
      ]
    },
    "asar": true,
    "extraResources": [
      "app/index.js",
      {
        "from": "node_modules/ffmpeg-static/ffmpeg",
        "to": ""
      },
      {
        "from": "packages/haiku-plumbing/bins",
        "to": "template-design-files"
      }
    ],
    "files": [
      "package.json",
      "node_modules/**/*",
      "*.js",
      "!**/{README,readme,test,__tests__,tests,powered-test,example,examples,demo,demos}",
      "!node_modules/.bin",
      "!**/*.{md,iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj,ts,map,d.ts,idea}",
      "!**/.editorconfig",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,__pycache__,thumbs.db,.gitignore,.gitattributes,.editorconfig,.flowconfig,.yarn-metadata.json,.idea,appveyor.yml,.travis.yml,circle.yml,npm-debug.log,yarn-debug.log,.nyc_output,yarn.lock,.yarn-integrity,tslint*.json,tsconfig*.json}",
      "!node_modules/eslint*",
      "!node_modules/monaco-editor/dev",
      "!node_modules/mout",
      "!node_modules/proxyquire",
      "!node_modules/sinon",
      "!node_modules/table",
      "!node_modules/ffmpeg-static",
      "!node_modules/haiku-plumbing/dev${/*}",
      "!node_modules/haiku-plumbing/docs${/*}",
      "!node_modules/haiku-plumbing/src${/*}",
      "!node_modules/haiku-plumbing/test${/*}",
      "!node_modules/@haiku/cli/src${/*}",
      "!node_modules/haiku-creator/src${/*}",
      "!node_modules/haiku-glass/src${/*}",
      "!node_modules/@haiku/sdk-client/src${/*}",
      "!node_modules/haiku-sdk-creator/src${/*}",
      "!node_modules/haiku-timeline/src${/*}",
      "!node_modules/haiku-testing${/*}",
      "!node_modules/haiku-ui-common/src${/*}",
      "!node_modules/@haiku/core/dist${/*}",
      "!node_modules/@haiku/core/src${/*}",
      "!node_modules/@haiku/core/test${/*}",
      "!node_modules/playwright-core",
      "!node_modules/@haiku/core/demo${/*}",
      "!node_modules/haiku-formats/demos${/*}"
    ]
  }
}
