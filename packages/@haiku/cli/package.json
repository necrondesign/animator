{
  "name": "@haiku/cli",
  "version": "5.1.2",
  "description": "motion-side CLI",
  "main": "lib/index.js",
  "scripts": {
    "lint": "eslint .",
    "ts": "cross-env NODE_ENV=test ts-node -T -r haiku-testing/isolate-home -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "yarn ts ./node_modules/.bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc yarn ts ./node_modules/.bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsc",
    "develop": "tsc --watch",
    "typecheck": "tsc -p tsconfig.all.json --noEmit"
  },
  "bin": {
    "motion-side": "./bin/motion-side"
  },
  "authors": [
    "Zack Brown <zack@haiku.ai>",
    "Matthew Trost <matthew@haiku.ai>"
  ],
  "files": [
    "bin/**/*",
    "lib/**/*",
    "src/**/*"
  ],
  "license": "MIT",
  "dependencies": {
    "@haiku/sdk-client": "5.1.2",
    "lodash": "^4.17.4",
    "yargs": "^6.6.0"
  },
  "devDependencies": {
    "@types/yargs": "^6.5.0",
    "cross-env": "^5.1.6",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "leaked-handles": "^5.2.0",
    "haiku-testing": "5.1.2"
  }
}
