{
  "name": "@haiku/core",
  "version": "5.1.2",
  "description": "Haiku Core is a JavaScript library for building user interfaces",
  "homepage": "https://www.haikuforteams.com",
  "directories": {
    "lib": "lib",
    "dom": "dom",
    "components": "components",
    "dist": "dist"
  },
  "keywords": [
    "animation",
    "motion",
    "component",
    "web",
    "browser",
    "svg",
    "rendering",
    "engine"
  ],
  "repository": "https://github.com/HaikuTeam/core",
  "main": "index.js",
  "types": "lib/HaikuGlobal.d.ts",
  "scripts": {
    "lint": "eslint .",
    "ts": "cross-env NODE_ENV=test ts-node -T -r haiku-testing/isolate-home -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "yarn ts ./node_modules/.bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc yarn ts ./node_modules/.bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsc",
    "develop": "tsc --watch",
    "bundle": "yarn compile && yarn ts ./scripts/bundle.ts",
    "demos": "yarn ts ./scripts/demos.ts",
    "typecheck": "tsc -p tsconfig.all.json --noEmit"
  },
  "authors": [
    "Matthew Trost <matthew@haiku.ai>",
    "Zack Brown <zack@haiku.ai>",
    "Taylor Poe <taylor@haiku.ai>",
    "Sasha Joseph <sasha@haiku.ai>"
  ],
  "license": "MIT",
  "devDependencies": {
    "async": "^2.5.0",
    "chokidar": "^3.6.0",
    "cross-env": "^5.1.6",
    "depcheck": "^0.6.7",
    "express": "4.14.1",
    "filesize": "3.5.10",
    "fs-extra": "^4.0.2",
    "haiku-testing": "5.1.2",
    "handlebars": "^4.0.8",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "jsdom": "30.1.1",
    "leaked-handles": "^5.2.0",
    "nodemon": "3.1.14",
    "nyc": "^13.0.1",
    "opn": "^5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^4.1.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1",
    "vue": "3.5.43",
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
