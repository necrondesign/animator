{
  "name": "haiku-formats",
  "version": "5.1.2",
  "description": "Formatting-related utilities for Haiku.",
  "main": "lib/index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "lint": "eslint .",
    "ts": "cross-env NODE_ENV=test ts-node -T -r haiku-testing/isolate-home -r tsconfig-paths/register -P tsconfig.all.json",
    "test": "yarn ts ./node_modules/.bin/tape 'test/**/*.test.ts' | tap-spec",
    "test-report": "nyc yarn ts ./node_modules/.bin/tape 'test/**/*.test.ts' > test-result.tap",
    "compile": "tsc",
    "develop": "tsc --watch",
    "regenerate-goldens": "yarn ts ./scripts/regenerate-goldens.ts",
    "upgrade-goldens": "yarn ts ./scripts/upgrade-goldens.ts",
    "demos": "node ./scripts/demos.js",
    "typecheck": "tsc -p tsconfig.all.json --noEmit"
  },
  "authors": [
    "Sasha Joseph <sasha@haiku.ai>"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@haiku/core": "5.1.2",
    "bezier-easing": "^2.0.3",
    "ffmpeg-static": "5.3.0",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^4.0.2",
    "haiku-common": "5.1.2",
    "haiku-sdk-creator": "5.1.2",
    "haiku-serialization": "5.1.2",
    "image-size": "^0.6.3",
    "lodash": "^4.17.4"
  },
  "devDependencies": {
    "@types/async": "^2.0.49",
    "@types/bezier-easing": "^2.0.0",
    "@types/fluent-ffmpeg": "^2.1.6",
    "@types/fs-extra": "^4.0.8",
    "@types/image-size": "^0.0.29",
    "@types/lodash": "^4.14.108",
    "async": "^2.5.0",
    "cross-env": "^5.1.6",
    "istanbul-reporter-cobertura-haiku": "^1.0.2",
    "nyc": "^13.0.1",
    "tap-spec": "^4.1.2",
    "tape": "^4.9.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "leaked-handles": "^5.2.0",
    "haiku-testing": "5.1.2",
    "lottie-web": "5.1.20",
    "nodemon": "3.1.14",
    "ts-loader": "9.6.2",
    "walk-sync": "^0.3.2",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1"
  }
}
